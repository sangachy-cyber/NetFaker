# NetFaker 环境变量配置示例

# 应用配置
NETFAKER_DEBUG=true
NETFAKER_HOST=0.0.0.0
NETFAKER_PORT=8000
NETFAKER_LOG_LEVEL=INFO
NETFAKER_DATA_DIR=data

# HoloWAN API 配置
HOLOWAN_API_URL=http://localhost:8080
HOLOWAN_API_KEY=your-api-key-here
HOLOWAN_ENGINE_ID=1

# 数据库配置（如果需要）
DATABASE_URL=sqlite:///./netfaker.db

# 模型配置
MODEL_PATH=data/models/default_model.pt
TRAIN_BATCH_SIZE=32
TRAIN_EPOCHS=100
